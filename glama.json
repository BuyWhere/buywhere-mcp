{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "BuyWhere"
  ],
  "categories": [
    "AI & Machine Learning",
    "Developer Tools",
    "E-commerce",
    "Shopping",
    "Product Search",
    "Price Comparison"
  ],
  "website": "https://buywhere.ai",
  "blog": "https://buywhere.ai/blog",
  "description": "AI shopping MCP for live product search and price comparison across SEA and US merchants (Shopee, Lazada, Amazon SG/US, FairPrice, Carousell, and more). Remote endpoint: POST https://api.buywhere.ai/mcp (JSON-RPC 2.0, protocolVersion 2024-11-05). Auth: Bearer via POST https://api.buywhere.ai/v1/auth/register. Live tools (13): search_products, get_product, compare_products, get_deals, list_categories, find_best_price, find_similar, ingest_products, search_products_v2, get_product_v2, compare_products_v2, get_deals_v2, find_best_price_v2. v2 calls require deliver_to (ISO 3166-1 alpha-2). Do not use the legacy Glama twin BuyWhere/buywhere.",
  "tools": [
    {
      "name": "search_products",
      "description": "Search catalog by keyword, category, price, country.",
      "required_params": [
        "query"
      ]
    },
    {
      "name": "get_product",
      "description": "Full product details by ID.",
      "required_params": [
        "product_id"
      ]
    },
    {
      "name": "compare_products",
      "description": "Side-by-side comparison of products.",
      "required_params": [
        "ids"
      ]
    },
    {
      "name": "get_deals",
      "description": "Products with significant price drops."
    },
    {
      "name": "list_categories",
      "description": "Product category taxonomy."
    },
    {
      "name": "find_best_price",
      "description": "Cheapest listing for a product across merchants."
    },
    {
      "name": "find_similar",
      "description": "Similar products by vector similarity."
    },
    {
      "name": "ingest_products",
      "description": "Submit product URLs for catalog ingestion."
    },
    {
      "name": "search_products_v2",
      "description": "v2 search; REQUIRES deliver_to.",
      "required_params": [
        "query",
        "deliver_to"
      ]
    },
    {
      "name": "get_product_v2",
      "description": "v2 product details.",
      "required_params": [
        "product_id"
      ]
    },
    {
      "name": "compare_products_v2",
      "description": "v2 comparison; optional deliver_to.",
      "required_params": [
        "ids"
      ]
    },
    {
      "name": "get_deals_v2",
      "description": "v2 deals; REQUIRES deliver_to.",
      "required_params": [
        "deliver_to"
      ]
    },
    {
      "name": "find_best_price_v2",
      "description": "v2 best price; REQUIRES deliver_to.",
      "required_params": [
        "product_name",
        "deliver_to"
      ]
    }
  ],
  "tooling": {
    "version": "live-2026-09-02",
    "contract": "v1 + v2 (13 tools advertised at https://api.buywhere.ai/mcp)",
    "live_surface": "13 tools matching GET https://api.buywhere.ai/mcp",
    "remote": "https://api.buywhere.ai/mcp",
    "protocolVersion": "2024-11-05",
    "v1_deprecates_on": "2026-10-01T00:00:00Z",
    "v1_retires_on": "2026-12-31T00:00:00Z",
    "migration_guide": "https://api.buywhere.ai/docs/agent-dx#migration-guide-v1-v2",
    "free_tier": {
      "calls_per_month": 1000,
      "sign_up_url": "https://buywhere.ai/api-keys"
    }
  }
