{
  "name": "@buywhere/mcp-server",
  "version": "0.3.17",
  "mcpName": "io.github.BuyWhere/buywhere-mcp",
  "description": "Agent-native product catalog MCP server. Search & compare 367M+ products across 932K+ merchants in the United States and Singapore (growing coverage across UK, EU, SEA, and AU). Location-aware search with `deliver_to` and `availability` labels (local | ships_to_you | unavailable | unknown); agent-optimized responses via `compact=true`. Built for AI agent commerce, not store management. Canonical stats: GET /v1/catalog/stats.",
  "keywords": [
    "buywhere",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "product-search",
    "product-search-api",
    "product-search-mcp",
    "agent-product-search",
    "mcp-commerce-search",
    "ecommerce-api",
    "ecommerce",
    "shopping-api",
    "shopping-agent",
    "shopping",
    "price-comparison",
    "compare-prices",
    "price-tracker",
    "deal-finder",
    "deal-discovery",
    "catalog-search",
    "product-catalog",
    "cross-border",
    "cross-border-shopping",
    "cross-border-commerce",
    "multi-currency",
    "real-time-pricing",
    "southeast-asia",
    "singapore",
    "sea-markets",
    "us-markets",
    "ai-agent",
    "ai-agents",
    "e-commerce",
    "ai-commerce",
    "agent-commerce",
    "agent-shopping",
    "agent-to-agent",
    "a2a",
    "google-a2a",
    "llm",
    "ai-tools",
    "claude-desktop",
    "cursor",
    "cline",
    "windsurf",
    "open-code",
    "codex",
    "continue-dev",
    "smithery",
    "mcp-tools",
    "typescript"
  ],
  "homepage": "https://buywhere.hashnode.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuyWhere/buywhere-mcp"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "buywhere-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "global-chat:register": "node scripts/register-global-chat.mjs",
    "content:sync-hashnode": "node scripts/sync-devto-to-hashnode.mjs",
    "metrics:collect": "node scripts/collect-mcp-metrics.mjs",
    "verify:registries": "node scripts/verify-mcp-registry-listings.mjs",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke-tools.mjs",
    "test": "node scripts/smoke-tools.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/BuyWhere"
  },
  "bugs": {
    "url": "https://github.com/BuyWhere/buywhere-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "undici-types": "^6.21.0"
  },
  "engines": {
    "node": ">=18"
  }
}